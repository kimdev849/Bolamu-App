# ──────────────────────────────────────────────────
# PSR PharmaFlow — Bolamu
# Variables d'environnement (exemple pour Render)
# ──────────────────────────────────────────────────

# Supabase PostgreSQL (transaction pooler — IPv4)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (session pooler — pour les migrations Prisma)
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-2.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="your-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Admin par défaut (créé par le seed)
ADMIN_EMAIL="admin@psr.com"
ADMIN_PASSWORD="Admin@123"

# Serveur
PORT=3000
NODE_ENV=production
