{
  "name": "psr-pharmaflow-backend",
  "version": "1.0.0",
  "description": "PSR PharmaFlow - Backend API (Prisma + Express + Supabase Postgres)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",

    "build": "npx prisma generate && tsc",
    "start": "npx prisma generate && npx tsx src/server.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "prisma:reset": "npx prisma migrate reset --force",
    "render:seed": "npx prisma db push --accept-data-loss && npx tsx src/seed.ts"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "prisma": "^6.0.0",
    "typescript": "~5.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0"
  }
}
